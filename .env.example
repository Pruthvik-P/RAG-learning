# Copy this file to ".env" and fill in your real key.
# The code loads ".env" automatically (see src/rag/config.py).

# --- DeepSeek (OpenAI-compatible) ---
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=1024
DEEPSEEK_TIMEOUT=60

# --- Retrieval / chunking ---
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
# similarity | mmr | keyword | hybrid
RAG_RETRIEVAL_MODE=similarity
RAG_MMR_LAMBDA=0.5

# --- Reranking (optional second pass over the retrieved candidates) ---
RAG_USE_RERANKING=false
# lexical (offline, default) | cross_encoder (needs sentence-transformers)
RAG_RERANK_KIND=lexical
RAG_RERANK_CANDIDATES=20

# --- Embeddings ---
# hashing (offline, default) | sentence_transformer | openai
RAG_EMBEDDING_PROVIDER=hashing
RAG_EMBEDDING_DIM=1024
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# If true, use an offline placeholder LLM when DEEPSEEK_API_KEY is missing.
RAG_ALLOW_OFFLINE=true
